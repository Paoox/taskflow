# TF-0003-01 — Variables de entorno de Taskflow (sin valores sensibles)
# Copiar a .env para desarrollo local.  .env NO se versiona.

# Ruta del archivo SQLite.
#   - Local (por defecto):  tareas.db
#   - Docker:               /app/data/tareas.db  (definido en el Dockerfile)
TASKFLOW_DB=tareas.db

# Clave de firma de sesión (protección CSRF, TF-0008 / TF-0012).
# En desarrollo (sin TASKFLOW_ENV=production): si falta, la app arranca con una
# clave efímera aleatoria + warning (las sesiones no persisten entre reinicios).
# En producción (TASKFLOW_ENV=production): OBLIGATORIA; si falta, el proceso
# aborta el arranque (RuntimeError).
# Generar una, p. ej.:  python -c "import secrets; print(secrets.token_hex(32))"
TASKFLOW_SECRET_KEY=

# Entorno de ejecución (TF-0012). Solo "production" cambia el comportamiento:
# activa el fail-fast de TASKFLOW_SECRET_KEY. Vacío = desarrollo.
TASKFLOW_ENV=

# Cookie de sesión con atributo Secure (TF-0012). Poner a 1 cuando la app se
# sirve tras TLS. Por defecto desactivada (desarrollo local sobre HTTP);
# activarla sobre HTTP impediría enviar la cookie y rompería el flujo CSRF.
TASKFLOW_COOKIE_SECURE=

# Arranque local con `python app.py` (TF-0017 / BL-10). Solo aplican a ese
# bloque; Docker usa `flask run` (ver Dockerfile) y no los lee.
#   TASKFLOW_DEBUG   activa el debugger de Werkzeug SOLO con un valor explícito
#                    (1 / true / yes / on). Vacío o 0 = desactivado (por defecto).
#                    NO activar fuera de desarrollo: expone ejecución de código.
#   TASKFLOW_HOST    interfaz de escucha. Por defecto 127.0.0.1 (solo loopback).
#   TASKFLOW_PORT    puerto de escucha. Por defecto 5000.
TASKFLOW_DEBUG=
TASKFLOW_HOST=
TASKFLOW_PORT=
