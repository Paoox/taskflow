# TF-0003-01 — Variables de entorno de Taskflow (sin valores sensibles)
# Copiar a .env para desarrollo local.  .env NO se versiona.

# Ruta del archivo SQLite.
#   - Local (por defecto):  tareas.db
#   - Docker:               /app/data/tareas.db  (definido en el Dockerfile)
TASKFLOW_DB=tareas.db

# Clave de firma de sesión (protección CSRF, TF-0008).
# OBLIGATORIA en despliegue: sin ella la app arranca con una clave efímera
# aleatoria (solo válida para desarrollo; las sesiones no persisten).
# Generar una, p. ej.:  python -c "import secrets; print(secrets.token_hex(32))"
TASKFLOW_SECRET_KEY=
