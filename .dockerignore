# TF-0003-01 — Contexto de build minimo y reproducible
venv/
**/__pycache__/
*.pyc
*.pyo

.git/
.gitignore
.dockerignore
Dockerfile
.idea/
.vscode/

# Secretos y config local: nunca dentro de la imagen (CLAUDE.md 25.3)
.env

# Base de datos local de desarrollo: el contenedor crea la suya en /app/data
tareas.db
*.db

# Documentacion no necesaria en runtime
CLAUDE.md
.claude/
docs/
README.md

# Pruebas y herramientas de test: no forman parte de la imagen de runtime
# (TF-0005; conftest.py y docs/ anadidos en TF-0012 / BL-11 ampliado)
tests/
conftest.py
pytest.ini
requirements-dev.txt
.pytest_cache/

# CI y artefactos de cobertura (TF-0010)
.github/
.coverage
.coverage.*
htmlcov/
coverage.xml
